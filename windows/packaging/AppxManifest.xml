<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest of ClearStar (desktop app, full trust). The placeholders in the Identity element are
  filled in by make-msix.ps1 from the values Partner Center shows under "Product identity"
  (Package/Identity/Name, Package/Identity/Publisher, Package/Properties/PublisherDisplayName);
  for a local test build the script uses its own defaults and a self-signed certificate.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 rescap">

  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ClearStar</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Beginner-friendly astrophotography processing – from raw frames to a finished image, step by step.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="hu-HU" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="ClearStar" Executable="ClearStar.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="ClearStar"
                          Description="Beginner-friendly astrophotography processing – from raw frames to a finished image, step by step."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\LargeTile.png" Square71x71Logo="Assets\SmallTile.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Open a FITS/TIFF file or a folder of frames with ClearStar from Explorer. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="astroimage">
            <uap:SupportedFileTypes>
              <uap:FileType>.fit</uap:FileType>
              <uap:FileType>.fits</uap:FileType>
              <uap:FileType>.fts</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>FITS image</uap:DisplayName>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
