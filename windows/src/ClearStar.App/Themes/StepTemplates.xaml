<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ClearStar.App"
                    xmlns:vm="clr-namespace:ClearStar.App.ViewModels"
                    xmlns:l="clr-namespace:ClearStar.App.Localization">

    <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
    <local:NullToVisibilityConverter x:Key="NullToVis"/>
    <local:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True"/>
    <local:IconConverter x:Key="Icon"/>
    <local:FractionToWidthConverter x:Key="FractionToWidth"/>

    <!-- ===== Beállítás-típusok ===== -->
    <DataTemplate DataType="{x:Type vm:SliderParameterViewModel}">
        <StackPanel Margin="0,0,0,14" ToolTip="{Binding Help}">
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{Binding Label}" FontSize="12.5"/>
                <TextBlock Text="{Binding ValueLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Right"/>
            </Grid>
            <Slider Value="{Binding Value, Mode=TwoWay}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"/>
            <Grid Margin="0,6,0,0">
                <TextBlock Text="{Binding TickLabels[0]}" Style="{StaticResource T.Muted}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding TickLabels[1]}" Style="{StaticResource T.Muted}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TickLabels[2]}" Style="{StaticResource T.Muted}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ToggleParameterViewModel}">
        <Grid Margin="0,0,0,14" ToolTip="{Binding Help}">
            <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,50,0"/>
            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChoiceParameterViewModel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Label}" FontSize="12.5" Margin="0,0,0,8"/>
            <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" FontSize="12.5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TextParameterViewModel}">
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Label}" FontSize="12.5" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FolderParameterViewModel}">
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Label}" FontSize="12.5" Margin="0,0,0,6"/>
            <Border CornerRadius="8" Background="#0DFFFFFF" BorderBrush="{StaticResource B.StrokeStrong}" BorderThickness="1" Padding="10,0" Height="34">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource I.Folder}" Stroke="{StaticResource B.Text2}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" Style="{StaticResource T.Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource Btn.Secondary}" Content="{l:T ui.step.chooseFolder}" Command="{Binding BrowseCommand}" Height="30" Padding="12,0" FontWeight="Normal"/>
                <Button Style="{StaticResource Btn.Link}" Content="{l:T ui.step.singleImage}" Command="{Binding BrowseFileCommand}" Height="30"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ModelParameterViewModel}">
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Label}" FontSize="12.5" Margin="0,0,0,6"/>
            <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding StatusText}" Margin="0,2,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Secondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource B.Amber}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding DownloadProgress, Mode=OneWay}" Margin="0,0,0,8" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Secondary}" Content="{l:T ui.model.refresh}" Command="{Binding RefreshCommand}" Height="30" Padding="12,0" FontWeight="Normal"/>
                <Button Style="{StaticResource Btn.Link}" Content="{l:T ui.model.browse}" Command="{Binding BrowseCommand}" Height="30"/>
                <Button Style="{StaticResource Btn.Link}" Content="{l:T ui.model.download}" Command="{Binding DownloadCommand}" Height="30"/>
                <Button Style="{StaticResource Btn.Link}" Content="{l:T ui.model.downloadUrl}" Command="{Binding DownloadUrlCommand}" Height="30"/>
            </StackPanel>
            <TextBlock Text="{l:T ui.model.license}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </DataTemplate>

    <!-- ===== Csoportfejléc ===== -->
    <DataTemplate DataType="{x:Type vm:GroupHeaderViewModel}">
        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Group}"/>
    </DataTemplate>

    <!-- ===== Lépéskártya ===== -->
    <DataTemplate DataType="{x:Type vm:StepViewModel}">
        <Border x:Name="card" CornerRadius="10" Margin="0,1" Padding="4" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
            <StackPanel>
                <Button x:Name="header" Style="{StaticResource Btn.StepHeader}" Command="{Binding SelectCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="badge" Width="22" Height="22" CornerRadius="11" Background="{StaticResource B.Badge}" Margin="0,0,10,0">
                            <Grid>
                                <TextBlock x:Name="badgeNum" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="badgeCheck" Data="{StaticResource I.Check}" Stroke="{StaticResource B.Green}" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                                <Path x:Name="badgeSkip" Data="{StaticResource I.Minus}" Stroke="{StaticResource B.Text3}" StrokeThickness="2.4" StrokeStartLineCap="Round" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"/>
                                <TextBlock x:Name="badgeStale" Text="!" FontSize="12" FontWeight="Bold" Foreground="{StaticResource B.Amber}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Path x:Name="icon" Grid.Column="1" Data="{Binding IconKey, Converter={StaticResource Icon}}" Stroke="{StaticResource B.Text3}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock x:Name="name" Grid.Column="2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center">
                            <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding TechnicalName, Mode=OneWay}" Foreground="{StaticResource B.Text3}" FontSize="12"/>
                        </TextBlock>
                        <TextBlock x:Name="meta" Grid.Column="3" Text="{Binding MetaText}" Style="{StaticResource T.Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="120" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <StackPanel x:Name="body" Margin="12,10,12,10" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Secondary}" Margin="0,0,0,16"/>

                    <Border Visibility="{Binding IsImplemented, Converter={StaticResource InvBoolToVis}}" CornerRadius="8" Background="{StaticResource B.AmberSoft}" Padding="10,8" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource T.Secondary}" Foreground="{StaticResource B.Amber}" Text="{l:T ui.step.notImplemented}"/>
                    </Border>

                    <Grid Margin="0,0,0,14" Visibility="{Binding Note, Converter={StaticResource NullToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource T.Secondary}" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Link}" Content="{Binding NoteActionText}" Command="{Binding NoteCommand}" VerticalAlignment="Center" Height="24" Foreground="{StaticResource B.Text2}"
                                Visibility="{Binding NoteActionText, Converter={StaticResource NullToVis}}"/>
                    </Grid>

                    <Button Style="{StaticResource Btn.Secondary}" Content="{Binding SecondaryActionText}" Command="{Binding SecondaryCommand}" Height="30" Padding="12,0" FontWeight="Normal" HorizontalAlignment="Left" Margin="0,0,0,14"
                            Visibility="{Binding SecondaryActionText, Converter={StaticResource NullToVis}}"/>

                    <ItemsControl ItemsSource="{Binding BasicParameters}"/>

                    <StackPanel Visibility="{Binding HasAdvanced, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource Btn.StepHeader}" Command="{Binding ToggleAdvancedCommand}" Height="30" Padding="0" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="{l:T ui.step.advanced}" Style="{StaticResource T.Secondary}" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource I.Chevron}" Stroke="{StaticResource B.Text3}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowAdvanced}" Value="True">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding AdvancedParameters}" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Grid Margin="0,4,0,0">
                        <Button Style="{StaticResource Btn.Primary}" Content="{Binding PrimaryButtonText}" Command="{Binding ApplyCommand}" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Link}" Content="{l:T ui.step.reset}" Command="{Binding ResetParametersCommand}" Foreground="{StaticResource B.Text3}" Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource Btn.Link}" Content="{l:T ui.step.skip}" Command="{Binding SkipCommand}" Visibility="{Binding CanSkip, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="card" Property="Background" Value="{StaticResource B.CardActive}"/>
                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource B.AccentBorder}"/>
                <Setter TargetName="card" Property="Margin" Value="0,3,0,6"/>
                <Setter TargetName="header" Property="Background" Value="{StaticResource B.AccentSoft}"/>
                <Setter TargetName="badge" Property="Background" Value="{StaticResource B.Accent}"/>
                <Setter TargetName="badgeNum" Property="Foreground" Value="{StaticResource B.AccentText}"/>
                <Setter TargetName="icon" Property="Stroke" Value="{StaticResource B.Accent}"/>
                <Setter TargetName="name" Property="Foreground" Value="{StaticResource B.Text}"/>
                <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="badgeCheck" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="badgeStale" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="badgeSkip" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="badgeNum" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsDone}" Value="True"/>
                    <Condition Binding="{Binding IsActive}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="badge" Property="Background" Value="{StaticResource B.GreenSoft}"/>
                <Setter TargetName="badgeNum" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="badgeCheck" Property="Visibility" Value="Visible"/>
                <Setter TargetName="icon" Property="Stroke" Value="{StaticResource B.Text2}"/>
                <Setter TargetName="name" Property="Foreground" Value="{StaticResource B.Text2}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSkipped}" Value="True"/>
                    <Condition Binding="{Binding IsActive}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="badgeNum" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="badgeSkip" Property="Visibility" Value="Visible"/>
                <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsStale}" Value="True"/>
                    <Condition Binding="{Binding IsActive}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="badge" Property="Background" Value="{StaticResource B.AmberSoft}"/>
                <Setter TargetName="badgeNum" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="badgeStale" Property="Visibility" Value="Visible"/>
                <Setter TargetName="meta" Property="Foreground" Value="{StaticResource B.Amber}"/>
                <Setter TargetName="icon" Property="Stroke" Value="{StaticResource B.Text2}"/>
                <Setter TargetName="name" Property="Foreground" Value="{StaticResource B.Text2}"/>
            </MultiDataTrigger>        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
