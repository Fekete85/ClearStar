<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- x64 only: the DirectML runtime (DirectML.dll) is copied to the output only for a concrete platform target. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- The UI is localised from Languages/*.json; skip the framework's own satellite resource folders (de, ja, ...). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Published builds carry their symbols inside the assemblies (no .pdb files next to the exe). -->
    <DebugType Condition="'$(_IsPublishing)' == 'true'">embedded</DebugType>
    <Company>ClearStar</Company>
    <Product>ClearStar</Product>
    <Authors>Laszlo Fekete</Authors>
    <Copyright>© 2026 Laszlo Fekete</Copyright>
    <Description>Vezetett asztrofotó-feldolgozó alkalmazás kezdőknek</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
