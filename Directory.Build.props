<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- x64 only: the DirectML runtime (DirectML.dll) is copied to the output only for a concrete platform target. -->
    <PlatformTarget>x64</PlatformTarget>
    <Company>ClearStar</Company>
    <Product>ClearStar</Product>
    <Authors>ClearStar</Authors>
    <Copyright>© 2026 ClearStar</Copyright>
    <Description>Vezetett asztrofotó-feldolgozó alkalmazás kezdőknek</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
