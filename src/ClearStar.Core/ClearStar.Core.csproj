<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Beépített nyelvek: ClearStar.Core.Languages.<kód>.json néven ágyazódnak be. -->
    <EmbeddedResource Include="Languages\*.json" LogicalName="ClearStar.Core.Languages.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
