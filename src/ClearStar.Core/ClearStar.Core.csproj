<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- DirectML build: runs the AI models on any DirectX 12 GPU (NVIDIA/AMD/Intel), with CPU fallback. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <!-- BZip2 decompression of the downloaded offline star catalogue (MIT). -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Beépített nyelvek: ClearStar.Core.Languages.<kód>.json néven ágyazódnak be. -->
    <EmbeddedResource Include="Languages\*.json" LogicalName="ClearStar.Core.Languages.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
