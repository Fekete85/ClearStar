<Window x:Class="ClearStar.App.Views.CatalogSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClearStar.App.Localization"
        Title="{l:T ui.catalog.title}" Width="640" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource B.Bg}" FontFamily="{StaticResource F.Body}" ShowInTaskbar="False" Icon="/Assets/clearstar.ico"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{l:T ui.catalog.whatTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="{l:T ui.catalog.what}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" FontSize="12.5"/>

        <TextBlock Text="{l:T ui.catalog.howTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <TextBlock Text="{l:T ui.catalog.how}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" FontSize="12.5"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="DownloadButton" Style="{StaticResource Btn.Primary}" Content="{l:T ui.catalog.download}" Click="Download" Height="32" Padding="14,0" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Style="{StaticResource Btn.Secondary}" Content="{l:T ui.catalog.cancel}" Click="CancelDownload" Height="32" Padding="14,0" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button Style="{StaticResource Btn.Secondary}" Content="{l:T ui.catalog.browse}" Click="Browse" Height="32" Padding="14,0" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Btn.Link}" Content="{l:T ui.catalog.manual}" Click="OpenRecord" Height="32"/>
        </StackPanel>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="ProgressText" Style="{StaticResource T.Secondary}" Margin="0,4,0,0" Visibility="Collapsed"/>

        <Border Background="{StaticResource B.Layer}" BorderBrush="{StaticResource B.Stroke}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12.5"/>
                <TextBlock Text="{l:T ui.catalog.sirilNote}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Btn.Secondary}" Content="{l:T ui.dialog.close}" IsCancel="True" Height="32" Padding="16,0"/>
        </StackPanel>
    </StackPanel>
</Window>
