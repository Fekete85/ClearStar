<Window x:Class="ClearStar.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClearStar.App.Localization"
        Title="{l:T ui.about.title}" Width="820" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource B.Bg}"
        FontFamily="{StaticResource F.Body}" ShowInTaskbar="False" Icon="/Assets/clearstar.ico"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fejléc: ikon, név, verzió, egy mondat -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/clearstar_icon.png" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ClearStar" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource T.Secondary}" FontSize="12.5"/>
                <TextBlock x:Name="CopyrightText" Style="{StaticResource T.Secondary}" FontSize="12.5"/>
                <TextBlock Text="{l:T ui.about.tagline}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Fülek -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <ToggleButton x:Name="TabAbout" Style="{StaticResource Btn.ToolToggle}" Content="{l:T ui.about.tabAbout}" IsChecked="True" Checked="TabChecked" Tag="about" Margin="0,0,4,0"/>
            <ToggleButton x:Name="TabLicense" Style="{StaticResource Btn.ToolToggle}" Content="{l:T ui.about.tabLicense}" Checked="TabChecked" Tag="license" Margin="0,0,4,0"/>
            <ToggleButton x:Name="TabThirdParty" Style="{StaticResource Btn.ToolToggle}" Content="{l:T ui.about.tabThirdParty}" Checked="TabChecked" Tag="thirdparty" Margin="0,0,4,0"/>
            <ToggleButton x:Name="TabModels" Style="{StaticResource Btn.ToolToggle}" Content="{l:T ui.about.tabModels}" Checked="TabChecked" Tag="models"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource B.Layer}" BorderBrush="{StaticResource B.Stroke}" BorderThickness="1" CornerRadius="10" Padding="16,12">
            <Grid>
                <!-- Névjegy fül: nyelv + rövid jogi összefoglaló -->
                <ScrollViewer x:Name="AboutScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel x:Name="AboutPanel">
                    <TextBlock Text="{l:T ui.about.language}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox x:Name="LanguageList" Style="{StaticResource ChoiceList}" SelectionChanged="LanguageChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{l:T ui.about.languageNote}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LanguageFolderText" Style="{StaticResource T.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                        <Button Style="{StaticResource Btn.Link}" Content="{l:T ui.about.languageFolder}" Click="OpenLanguageFolder" Height="24" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="RestartButton" Style="{StaticResource Btn.Primary}" Content="{l:T ui.about.restart}" Click="Restart" HorizontalAlignment="Left" Height="32" Padding="16,0" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <Border Height="1" Background="{StaticResource B.Stroke}" Margin="0,16,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T ui.about.gpu}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="GpuSwitch" Grid.Column="1" Style="{StaticResource Switch}" Checked="GpuChanged" Unchecked="GpuChanged"/>
                    </Grid>
                    <TextBlock Text="{l:T ui.about.gpuNote}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Border Height="1" Background="{StaticResource B.Stroke}" Margin="0,16,0,12"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" FontSize="12.5"/>
                    <!-- Support: the same note as on the welcome screen -->
                    <Border CornerRadius="10" Background="{StaticResource B.AmberSoft}" BorderBrush="{StaticResource B.Stroke}" BorderThickness="1" Padding="14,10" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T ui.welcome.support}" Style="{StaticResource T.Secondary}" FontSize="12.5" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Btn.Secondary}" Content="{l:T ui.welcome.supportButton}" Click="OpenSupport" Height="30" Padding="14,0" FontWeight="Normal"/>
                                <TextBlock x:Name="SupportUrlText" Style="{StaticResource T.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource B.Text3}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <!-- Szöveges fülek -->
                <TextBox x:Name="TextPanel" Style="{x:Null}" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap"
                         Background="Transparent" Foreground="{StaticResource B.Text2}" BorderThickness="0"
                         FontFamily="{StaticResource F.Body}" FontSize="12.5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                <!-- Markdown tab (third-party notices): rendered as a flow document -->
                <FlowDocumentScrollViewer x:Name="DocPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          IsSelectionEnabled="True" Margin="0" Padding="0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Btn.Secondary}" Content="{l:T ui.dialog.close}" IsCancel="True" Height="32" Padding="16,0"/>
        </StackPanel>
    </Grid>
</Window>
