<UserControl x:Class="ClearStar.App.Controls.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClearStar.App.Localization"
             Background="{StaticResource B.View}" ClipToBounds="True" Focusable="True">
    <Grid>
        <Canvas x:Name="Surface" Background="Transparent"
                MouseWheel="OnMouseWheel" MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseMove="OnMouseMove"
                SizeChanged="OnSurfaceSizeChanged">
            <Grid x:Name="ContentHost" RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <MatrixTransform x:Name="Transform"/>
                </Grid.RenderTransform>
                <Image x:Name="AfterImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image x:Name="BeforeImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed">
                    <Image.Clip>
                        <RectangleGeometry x:Name="BeforeClip"/>
                    </Image.Clip>
                </Image>
            </Grid>
        </Canvas>

        <!-- Osztott nézet elválasztója -->
        <Grid x:Name="SplitOverlay" Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle x:Name="SplitLine" Width="2" Fill="White" HorizontalAlignment="Left" Opacity="0.9"/>
            <Border x:Name="SplitLabelBefore" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="10,4" CornerRadius="6" Background="#8C000000">
                <TextBlock Text="{l:T ui.viewer.before}" FontWeight="SemiBold" FontSize="12"/>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="10,4" CornerRadius="6" Background="{StaticResource B.Accent}">
                <TextBlock Text="{l:T ui.viewer.after}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource B.AccentText}"/>
            </Border>
        </Grid>

        <!-- Kijelölés (vágás) -->
        <Canvas x:Name="SelectionOverlay" Visibility="Collapsed" IsHitTestVisible="False">
            <Path x:Name="SelDim" Fill="#8C000000"/>
            <Rectangle x:Name="SelBorder" Stroke="{StaticResource B.Accent}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
            <Border x:Name="SelLabel" Padding="8,3" CornerRadius="5" Background="{StaticResource B.Accent}">
                <TextBlock x:Name="SelLabelText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource B.AccentText}"/>
            </Border>
        </Canvas>
        <Border x:Name="SelectionHint" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16" Padding="12,6" CornerRadius="6" Background="#B3202023" BorderBrush="{StaticResource B.StrokeStrong}" BorderThickness="1">
            <TextBlock Text="{l:T ui.viewer.selectionHint}" FontSize="12" Foreground="{StaticResource B.Text2}"/>
        </Border>

        <!-- Nagyítás -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" CornerRadius="8" Background="#D9202023"
                BorderBrush="{StaticResource B.StrokeStrong}" BorderThickness="1" Padding="2">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Icon}" Click="ZoomOut" ToolTip="{l:T ui.viewer.zoomOut}">
                    <Path Data="{StaticResource I.Minus}" Stroke="{StaticResource B.Text2}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <TextBlock x:Name="ZoomLabel" Text="100%" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                <Button Style="{StaticResource Btn.Icon}" Click="ZoomIn" ToolTip="{l:T ui.viewer.zoomIn}">
                    <Path Data="{StaticResource I.Plus}" Stroke="{StaticResource B.Text2}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Rectangle Width="1" Height="18" Fill="{StaticResource B.StrokeStrong}" Margin="4,0"/>
                <Button Style="{StaticResource Btn.Icon}" Click="FitClick" ToolTip="{l:T ui.viewer.fit}">
                    <Path Data="{StaticResource I.Fit}" Stroke="{StaticResource B.Text2}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource Btn.Tool}" Click="ActualSizeClick" Content="100%" Padding="10,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
